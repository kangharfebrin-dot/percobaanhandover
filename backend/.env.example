# Database Configuration (MySQL / MariaDB via Prisma)
DATABASE_URL="mysql://username:password@localhost:3306/handover_pertamina"

# Port & Server Settings
PORT=3000
NODE_ENV=development

# Authentication & Security (Gunakan string acak minimal 32 karakter di produksi)
JWT_SECRET="ganti_dengan_jwt_secret_produksi_yang_panjang_dan_acak"
REFRESH_SECRET="ganti_dengan_refresh_secret_produksi_yang_panjang_dan_acak"

# CORS Origin Allowed
CORS_ORIGIN="http://localhost:8081,http://localhost:3000"

# Email Notification Settings (SMTP Gmail)
ADMIN_EMAIL=admin@example.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Redis Cache (Opsional)
REDIS_URL="redis://127.0.0.1:6379"
