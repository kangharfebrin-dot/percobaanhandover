generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ChecklistItem {
  id        String   @id @default(cuid())
  category  String
  name      String
  severity  String   @default("Minor")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklistitem")
}

model Handover {
  id          String   @id @default(cuid())
  noPolisi    String
  shift       String
  status      String
  type        String   @default("mulai")
  locationLat Float?
  locationLng Float?
  timestamp   DateTime @default(now())
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id])
  items  HandoverItem[]
  photos Photo[]
  issue  Issue?

  @@index([userId], map: "Handover_userId_fkey")
  @@index([createdAt, status, noPolisi])
  @@map("handover")
}

model HandoverItem {
  id         String  @id @default(cuid())
  category   String
  name       String
  isGood     Boolean
  handoverId String

  repairNote     String?
  repairPhotoUrl String?
  isRepaired     Boolean @default(false)
  adminRejectionNote String?

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId], map: "HandoverItem_handoverId_fkey")
  @@map("handoveritem")
}

model Issue {
  id                String    @id @default(cuid())
  handoverId        String    @unique(map: "Issue_handoverId_key")
  status            String    @default("ONGOING")
  resolvedAt        DateTime?
  repairRequestedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@map("issue")
}

model Photo {
  id           String @id @default(cuid())
  type         String
  url          String
  thumbnailUrl String?
  previewUrl   String?
  originalSize Int?
  handoverId   String

  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@index([handoverId], map: "Photo_handoverId_fkey")
  @@map("photo")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique(map: "User_username_key")
  password  String
  role      String
  name      String
  jabatan   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshToken String? @db.Text
  fcmToken     String?

  handovers Handover[]

  @@map("user")
}

model Vehicle {
  id             String   @id @default(cuid())
  noPolisi       String   @unique(map: "Vehicle_noPolisi_key")
  barcode        String   @unique(map: "Vehicle_barcode_key")
  jenisKendaraan String?
  brand          String?
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("vehicle")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  isRead      Boolean  @default(false)
  type        String   @default("INFO")
  targetRole  String?  @default("ADMIN")
  createdAt   DateTime @default(now())

  @@map("notification")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@map("audit_log")
}
