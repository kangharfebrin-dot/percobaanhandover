datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String
  role      String     // 'ADMIN' atau 'USER'
  name      String
  handovers Handover[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Handover {
  id              String         @id @default(uuid())
  noPolisi        String
  shift           String
  status          String         // 'Siap Operasi (Normal)' atau 'Ada Masalah'
  locationLat     Float?
  locationLng     Float?
  timestamp       DateTime       @default(now())
  
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  
  items           HandoverItem[]
  photos          Photo[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model HandoverItem {
  id          String   @id @default(uuid())
  category    String   // 'A', 'B', atau 'C'
  name        String
  isGood      Boolean  // true = Baik/Ada, false = Tidak Baik/Tidak Ada
  
  handoverId  String
  handover    Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
}

model Photo {
  id          String   @id @default(uuid())
  type        String   // 'DEPAN', 'BELAKANG', 'KANAN', 'KIRI'
  url         String
  
  handoverId  String
  handover    Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id              String   @id @default(uuid())
  noPolisi        String   @unique
  barcode         String   @unique
  jenisKendaraan  String?  // e.g., Truk Tangki, Mobil Box, dll
  brand           String?
  status          String   @default("Active") // 'Active' or 'Maintenance'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
